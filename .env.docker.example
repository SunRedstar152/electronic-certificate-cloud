# Copy to .env.docker and fill in both secrets before starting Compose.
# Generate separate values with: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
SECRET_KEY=

POSTGRES_USER=certificate_app
# Main application database used by every service.
POSTGRES_DB=pkru_certificate
PUBLIC_BASE_URL=http://localhost:8000
APP_BIND_HOST=127.0.0.1
APP_PORT=8000
AUDIT_RETENTION_DAYS=365
LOGIN_PAIR_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=30
LOGIN_WINDOW_SECONDS=900

# Automatic database + storage backups while Docker is running.
BACKUP_DIRECTORY=./backups
BACKUP_TIMEZONE=Asia/Bangkok
BACKUP_DAILY_TIME=03:00
BACKUP_RETAIN_COUNT=14
BACKUP_RETRY_SECONDS=900

# Lossless PNG compression (0-9); default 9 favors smaller files. Use 6 for faster encoding.
PNG_COMPRESS_LEVEL=9

# New certificate storage; downloads remain PNG/JPG/PDF.
CERTIFICATE_STORAGE_FORMAT=webp
WEBP_METHOD=4
