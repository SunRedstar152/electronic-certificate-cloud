# PostgreSQL connection string. Replace every placeholder in a private .env file.
DATABASE_URL=postgresql+psycopg://certificate_app:replace-me@127.0.0.1:5432/pkru_certificate

# Generate a unique random value with at least 32 characters; never commit it.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Public HTTPS address used by certificate QR codes.
PUBLIC_BASE_URL=https://certificates.example.edu

# Writable persistent storage for uploads and generated certificates.
TEMPLATE_DIR=storage/uploads/templates
CERTIFICATE_DIR=storage/generated/certificates
FONT_DIR=storage/uploads/fonts
REQUIRE_RAQM=false

# Number of days to retain audit records before scheduled cleanup.
AUDIT_RETENTION_DAYS=365

# Enable only for one designated scheduler process, never for web workers.
ENABLE_SCHEDULER=false

# New certificate storage; downloads remain PNG/JPG/PDF.
CERTIFICATE_STORAGE_FORMAT=webp
WEBP_METHOD=4

# Use local for Docker/VPS; supabase for Koyeb (private bucket only).
STORAGE_BACKEND=local
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET
SUPABASE_STORAGE_BUCKET=certificate-files
STORAGE_CACHE_MB=256
STORAGE_TIMEOUT_SECONDS=30
